# Cairo environment variables
# Copy to .env.local (or .env) and fill in values.

# Database (required)
POSTGRES_URL=postgresql://username:password@hostname:port/database_name
# DATABASE_URL is also accepted for compatibility

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Optional: Sentry
# SENTRY_DSN=

# Optional: agent that receives critical error handoffs
# CAIRO_ERROR_AGENT_ID=error-relay-agent

# GCP Secret Manager (Cloud Run only)
# GCP_PROJECT_ID=
