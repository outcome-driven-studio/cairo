# Cairo environment variables
# Copy to .env.local (or .env) and fill in values.

# Database (required)
POSTGRES_URL=postgresql://username:password@hostname:port/database_name
# DATABASE_URL is also accepted for compatibility

# Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Auth
# In production (NODE_ENV=production) write keys are required — no bootstrap.
# Force the same behavior in any env:
# CAIRO_REQUIRE_WRITE_KEYS=true

# Rate limiting (per write key)
# CAIRO_RATE_LIMIT=120
# CAIRO_RATE_WINDOW_MS=60000

# Agent webhook push retries
# CAIRO_WEBHOOK_RETRIES=3
# CAIRO_WEBHOOK_RETRY_DELAY_MS=250

# Optional: Sentry
# SENTRY_DSN=

# Optional: agent that receives critical error handoffs
# CAIRO_ERROR_AGENT_ID=error-relay-agent

# GCP Secret Manager (Cloud Run only)
# GCP_PROJECT_ID=
