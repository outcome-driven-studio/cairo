{
  "name": "cairo",
  "version": "3.0.0",
  "private": true,
  "description": "Agent-first event tracking — ingest events, hand notifications to agents who relay via their own gateways",
  "bin": {
    "cairo": "./bin/cairo.js"
  },
  "files": [
    "bin/",
    "src/",
    "server.js",
    "start.sh",
    "llms.txt",
    "package.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "event-tracking",
    "agent-observability",
    "notifications",
    "headless",
    "ai-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/outcome-driven-studio/cairo.git"
  },
  "workspaces": [
    "packages/tracker",
    "packages/agent-mcp",
    "packages/agent-tracker",
    "packages/cairo-mcp"
  ],
  "dependencies": {
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/tasks": "^4.0.0",
    "@sentry/node": "^7.120.4",
    "@sentry/profiling-node": "^7.120.3",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "pg": "^8.16.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "dev": "LOG_LEVEL=debug nodemon server.js",
    "test": "jest --testPathPattern=src/test --forceExit",
    "setup": "node src/migrations/run_migrations.js",
    "setup-env": "node setup-env.js",
    "build": "npm run build --workspaces --if-present",
    "migrate": "node src/migrations/run_migrations.js",
    "publish:packages": "bash scripts/publish-packages.sh",
    "publish:packages:dry": "DRY_RUN=true bash scripts/publish-packages.sh"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10"
  }
}
